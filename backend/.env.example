APP_NAME=CourseRAGAgent
APP_ENV=dev

DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
# Applies to both streaming and non-streaming Agent calls.
DEEPSEEK_THINKING=false

EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

UPLOAD_DIR=./data/uploads
INDEX_DIR=./data/indexes
MEMORY_INDEX_DIR=./data/memory_indexes
SQLITE_PATH=./data/sqlite/app.db

CHUNK_SIZE=500
# Isolated MinerU standard parser; defaults resolve from the repository root.
PDF_PARSER=mineru
# MINERU_PYTHON=D:/NLP-CourseWork/data/tools/mineru/venv/Scripts/python.exe
# MINERU_HOME=D:/NLP-CourseWork/data/tools/mineru
# MINERU_CACHE_DIR=D:/NLP-CourseWork/data/parsed/mineru-upload
MINERU_TIMEOUT=1800
CHUNK_OVERLAP=80
VECTOR_TOP_K=10
BM25_TOP_K=10
FINAL_TOP_K=5
SUMMARY_FINAL_TOP_K=10
VECTOR_WEIGHT=0.6
BM25_WEIGHT=0.4
ENABLE_RERANKER=true

MEMORY_ENABLED=true
MEMORY_RECENT_TURNS=8
MEMORY_SUMMARY_THRESHOLD=12
MEMORY_RECALL_TOP_K=5

# Offline evaluation: blank endpoints/keys reuse DEEPSEEK settings.
EVAL_GENERATION_MODEL=deepseek-v4-flash
EVAL_JUDGE_MODEL=deepseek-v4-pro
EVAL_GENERATION_THINKING=false
EVAL_JUDGE_THINKING=false
EVAL_GENERATION_BASE_URL=
EVAL_JUDGE_BASE_URL=
EVAL_GENERATION_API_KEY=
EVAL_JUDGE_API_KEY=
EVAL_DIR=./data/evaluations
